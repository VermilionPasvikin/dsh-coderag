#!/bin/sh
# dsh-coderag 的统一 dsh 调用入口（薄包装）。
#
# 它只做两件事：
#   ① 找到 Python 解释器并导出 CODERAG_PYTHON——patch 里的默认值是作者机器的
#      路径，必须被覆盖（E-06）；这里探测到的就是 MCP 子进程该用的那一个。
#   ② 找到 dsh 并转发——干净终端里 dsh 不在 PATH 上（E-07），而裸 npx 会拉
#      latest、版本漂移，所以要钉版本。
# 其余逻辑一律在 Python CLI 里（src/dsh_coderag/__main__.py）。
#
# 用法：./scripts/dsh --version ／ ./scripts/dsh plugin --profile v add .
# 换 dsh 版本：改下面这一行，或设 DSH_VERSION=...
DSH_VERSION="${DSH_VERSION:-0.1.5-rc.1}"

if [ -z "${CODERAG_PYTHON:-}" ]; then
  if [ -n "${CONDA_PREFIX:-}" ] && [ -x "${CONDA_PREFIX}/bin/python" ]; then
    CODERAG_PYTHON="${CONDA_PREFIX}/bin/python"
  else
    for candidate in python3 python; do
      # 只认真的能跑的解释器：Windows 上 python3 可能是 Microsoft Store 占位符。
      if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c '' >/dev/null 2>&1; then
        CODERAG_PYTHON=$(command -v "$candidate")
        break
      fi
    done
  fi
  [ -n "${CODERAG_PYTHON:-}" ] && export CODERAG_PYTHON
fi

if [ "${DSH_FORCE_NPX:-0}" != "1" ] && command -v dsh >/dev/null 2>&1; then
  exec dsh "$@"
fi

exec npx --yes "@deepseek-ai/dsh@${DSH_VERSION}" "$@"
